#cloud-config
# =============================================================================
# Claude Code dev workstation — Proxmox LXC (Ubuntu 24.04 LTS) provisioning
# Provides: XFCE desktop + TigerVNC, Node.js + Claude Code, Docker, kubectl,
#           Helm, Terraform, and pre-trusted GitLab/Docker dev platform hosts.
#
# Tokens (__LIKE_THIS__) are rendered by create-lxc.sh before this file is
# written into the container's NoCloud seed. Edit values in create-lxc.sh,
# not here.
# =============================================================================

hostname: claude-dev
manage_etc_hosts: true
locale: en_US.UTF-8
timezone: Etc/UTC

# Keep the host's package cache fresh on first boot.
package_update: true
package_upgrade: true

users:
  - name: __DEV_USER__
    groups: [sudo, users]
    shell: /bin/bash
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
    lock_passwd: false
    # Password hash for console/sudo fallback; SSH-key login is preferred.
    # Generated by create-lxc.sh from VNC/login password.
    passwd: __LOGIN_PASSWORD_HASH__
    ssh_authorized_keys:
      - __SSH_PUBKEY__

packages:
  - xfce4
  - xfce4-goodies
  - xfce4-terminal
  - dbus-x11
  - tigervnc-standalone-server
  - tigervnc-common
  - tigervnc-tools
  - openssh-server
  - git
  - curl
  - wget
  - ca-certificates
  - gnupg
  - lsb-release
  - apt-transport-https
  - software-properties-common
  - build-essential
  - python3-pip
  - python3-venv
  - jq
  - unzip
  - ripgrep
  - htop
  - net-tools

write_files:
  # ---- TigerVNC session startup -------------------------------------------
  - path: /etc/skel/.vnc/xstartup
    permissions: '0755'
    content: |
      #!/bin/sh
      unset SESSION_MANAGER
      unset DBUS_SESSION_BUS_ADDRESS
      export XKL_XMODMAP_DISABLE=1
      [ -r "$HOME/.Xresources" ] && xrdb "$HOME/.Xresources"
      exec dbus-launch --exit-with-session startxfce4

  # ---- TigerVNC systemd unit (one instance per display) -------------------
  - path: /etc/systemd/system/vncserver@.service
    permissions: '0644'
    content: |
      [Unit]
      Description=TigerVNC server on display %i
      After=network.target

      [Service]
      Type=forking
      User=__DEV_USER__
      Group=__DEV_USER__
      WorkingDirectory=/home/__DEV_USER__
      PIDFile=/home/__DEV_USER__/.vnc/%H:%i.pid
      ExecStartPre=-/usr/bin/vncserver -kill :%i > /dev/null 2>&1
      ExecStart=/usr/bin/vncserver :%i -localhost yes -geometry 1600x900 -depth 24 -fg
      ExecStop=/usr/bin/vncserver -kill :%i

      [Install]
      WantedBy=multi-user.target

  # ---- Main provisioning script (invoked from runcmd) ---------------------
  - path: /usr/local/sbin/provision-dev.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      DEV_USER="__DEV_USER__"
      VNC_PASSWORD="__VNC_PASSWORD__"
      GIT_NAME="__GIT_NAME__"
      GIT_EMAIL="__GIT_EMAIL__"
      DEV_HOME="/home/${DEV_USER}"

      log() { echo "[provision] $*"; }

      export DEBIAN_FRONTEND=noninteractive

      # --- Node.js 20 LTS (NodeSource) + Claude Code -----------------------
      log "Installing Node.js 20 LTS"
      curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
      apt-get install -y nodejs
      log "Installing Claude Code CLI"
      npm install -g @anthropic-ai/claude-code

      # --- Docker Engine ---------------------------------------------------
      log "Installing Docker Engine"
      install -m 0755 -d /etc/apt/keyrings
      curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
        | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
      chmod a+r /etc/apt/keyrings/docker.gpg
      echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
        > /etc/apt/sources.list.d/docker.list
      apt-get update
      apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
      usermod -aG docker "${DEV_USER}"

      # --- kubectl (Kubernetes apt repo) -----------------------------------
      log "Installing kubectl"
      curl -fsSL https://pkgs.k8s.io/core:/stable:/v1.30/deb/Release.key \
        | gpg --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg
      echo "deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/v1.30/deb/ /" \
        > /etc/apt/sources.list.d/kubernetes.list
      apt-get update
      apt-get install -y kubectl

      # --- Helm ------------------------------------------------------------
      log "Installing Helm"
      curl -fsSL https://baltocdn.com/helm/signing.asc \
        | gpg --dearmor -o /etc/apt/keyrings/helm.gpg
      echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/helm.gpg] https://baltocdn.com/helm/stable/debian/ all main" \
        > /etc/apt/sources.list.d/helm-stable-debian.list
      apt-get update
      apt-get install -y helm

      # --- Terraform (HashiCorp apt repo) ----------------------------------
      log "Installing Terraform"
      curl -fsSL https://apt.releases.hashicorp.com/gpg \
        | gpg --dearmor -o /etc/apt/keyrings/hashicorp.gpg
      echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/hashicorp.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main" \
        > /etc/apt/sources.list.d/hashicorp.list
      apt-get update
      apt-get install -y terraform

      # --- VNC password ----------------------------------------------------
      log "Configuring TigerVNC for ${DEV_USER}"
      install -d -o "${DEV_USER}" -g "${DEV_USER}" -m 0700 "${DEV_HOME}/.vnc"
      echo "${VNC_PASSWORD}" | vncpasswd -f > "${DEV_HOME}/.vnc/passwd"
      chmod 0600 "${DEV_HOME}/.vnc/passwd"
      chown -R "${DEV_USER}:${DEV_USER}" "${DEV_HOME}/.vnc"

      # --- Git identity + trusted dev platform hosts -----------------------
      log "Configuring git and known_hosts (GitLab, GitHub, Docker)"
      sudo -u "${DEV_USER}" git config --global user.name "${GIT_NAME}"
      sudo -u "${DEV_USER}" git config --global user.email "${GIT_EMAIL}"
      sudo -u "${DEV_USER}" git config --global init.defaultBranch main
      sudo -u "${DEV_USER}" git config --global pull.rebase false

      install -d -o "${DEV_USER}" -g "${DEV_USER}" -m 0700 "${DEV_HOME}/.ssh"
      KNOWN="${DEV_HOME}/.ssh/known_hosts"
      : > "${KNOWN}.tmp"
      for host in gitlab.com github.com bitbucket.org ssh.dev.azure.com; do
        ssh-keyscan -T 10 "${host}" >> "${KNOWN}.tmp" 2>/dev/null || true
      done
      sort -u "${KNOWN}.tmp" > "${KNOWN}"
      rm -f "${KNOWN}.tmp"
      chown "${DEV_USER}:${DEV_USER}" "${KNOWN}"
      chmod 0644 "${KNOWN}"

      # --- Helpful shell defaults ------------------------------------------
      cat >> "${DEV_HOME}/.bashrc" <<'BASHRC'

      # --- Claude Code dev workstation ---
      export EDITOR=vim
      alias k=kubectl
      alias tf=terraform
      alias dc='docker compose'
      # Set ANTHROPIC_API_KEY here or run `claude` to log in interactively.
      # export ANTHROPIC_API_KEY="sk-ant-..."
      BASHRC
      chown "${DEV_USER}:${DEV_USER}" "${DEV_HOME}/.bashrc"

      # --- Enable services -------------------------------------------------
      log "Enabling Docker and VNC services"
      systemctl enable --now docker
      systemctl daemon-reload
      systemctl enable --now vncserver@1.service

      log "Provisioning complete."

runcmd:
  - [ bash, -lc, "mkdir -p /etc/skel/.vnc && chmod 0700 /etc/skel/.vnc" ]
  - [ bash, -lc, "/usr/local/sbin/provision-dev.sh 2>&1 | tee /var/log/provision-dev.log" ]

final_message: "Claude Code dev workstation is ready. VNC on display :1 (port 5901, localhost-only — tunnel via SSH). Run 'claude' as __DEV_USER__ to start."
